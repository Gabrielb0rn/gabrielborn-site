generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

// Registro único (id "main") com os dados do dono do portfólio
model SiteProfile {
  id          String   @id @default("main")
  name        String
  headline    String
  bio         String
  location    String?
  email       String
  githubUrl   String?
  linkedinUrl String?
  resumeUrl   String?
  openToWork  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Project {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  summary    String
  problem    String?
  role       String?
  challenges String?
  results    String?
  stack      String[]
  liveUrl    String?
  repoUrl    String?
  coverUrl   String?
  videoUrl   String?
  featured   Boolean        @default(false)
  position   Int            @default(0)
  status     PublishStatus  @default(DRAFT)
  startedAt  DateTime?
  finishedAt DateTime?
  images     ProjectImage[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, position])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model Education {
  id          String             @id @default(cuid())
  institution String
  course      String
  startDate   DateTime
  endDate     DateTime?
  description String?
  position    Int                @default(0)
  activities  AcademicActivity[]
}

model AcademicActivity {
  id          String        @id @default(cuid())
  educationId String
  education   Education     @relation(fields: [educationId], references: [id], onDelete: Cascade)
  title        String
  subject      String?
  // Ano do curso (1, 2, 3...) e trimestre (1 a 4). A navegação em níveis do
  // /arquivo sai de agrupar por estes dois campos, sem tabelas próprias.
  year         Int?
  term         Int?
  type         String // projeto, exercício, prova, apresentação...
  description  String?
  objectives   String[]
  development  String?
  results      String[]
  critique     String?
  skills       String[]
  technologies String[]
  // Nunca aparece nas páginas públicas. Fica só para consulta no admin.
  grade        Decimal?      @db.Decimal(4, 2)
  date         DateTime?
  links        String[]
  attachments  Json? // [{ "name": "...", "url": "..." }]
  status       PublishStatus @default(DRAFT)
  legacyId     String?       @unique // id da tabela Activity do banco antigo
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([educationId, status])
  @@index([educationId, year, term])
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String // front-end, back-end, 3D, ferramentas...
  position Int    @default(0)
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
}

// Registro único (id "main"). O cron diário grava a hora aqui, para o projeto
// gratuito do Supabase registrar uso real e não ser pausado.
model Heartbeat {
  id String   @id @default("main")
  at DateTime @default(now())
}
