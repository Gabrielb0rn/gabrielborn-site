# Copie para .env e preencha. O .env nunca vai para o git.

# Supabase > Connect > ORMs (Prisma)
# Usada pelo site em execução (pooler, modo transação, porta 6543).
DATABASE_URL=
# Usada pela CLI do Prisma para migrations (conexão direta ou pooler em modo sessão, porta 5432).
DIRECT_URL=

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Único e-mail com acesso ao /admin. Sem ele, ninguém entra.
ADMIN_EMAIL=

# Protege /api/keep-alive. Gere com: openssl rand -hex 32
CRON_SECRET=
